# --- Database ---------------------------------------------------------------
# Any PostgreSQL 14+ instance. Two databases are used (dev + test).
DATABASE_URL=postgresql://workshop:workshop_dev_password@127.0.0.1:5432/workshop_relay
DATABASE_URL_TEST=postgresql://workshop:workshop_dev_password@127.0.0.1:5432/workshop_relay_test

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated browser origins allowed for cross-origin API access.
# The dashboard is same-origin (served by the API), so this is usually empty.
API_CORS_ORIGINS=

# --- Mock notification service ----------------------------------------------
MOCK_HOST=0.0.0.0
MOCK_PORT=4100
# URL the worker (and API proxy) use to reach the mock service.
MOCK_NOTIFICATION_URL=http://127.0.0.1:4100
# Server-to-server token required by POST /notifications.
MOCK_AUTH_TOKEN=mock-service-token
# Admin token protecting /receipts and /admin/* endpoints.
MOCK_ADMIN_TOKEN=mock-admin-token

# --- Demo identities (seeded into demo_identities; NOT production auth) ------
ORGANIZER_TOKEN=organizer-demo-token
# comma-separated label:token pairs; each becomes a synthetic member.
MEMBER_TOKENS=alice:alice-demo-token,bob:bob-demo-token,carol:carol-demo-token,dave:dave-demo-token

# --- Worker -----------------------------------------------------------------
WORKER_ID=worker-1
WORKER_CONCURRENCY=5
WORKER_POLL_MS=500
WORKER_LEASE_MS=15000
WORKER_BATCH_SIZE=10

# --- Retry / HTTP delivery --------------------------------------------------
NOTIFICATION_TIMEOUT_MS=3000
RETRY_BASE_MS=1000
RETRY_CAP_MS=60000
RETRY_MIN_MS=100
# Upper bound applied to server-provided Retry-After values.
RETRY_AFTER_MAX_MS=300000
# Attempts after which retrying is logged at warn level (jobs are never dropped).
RETRY_ALERT_AFTER_ATTEMPTS=10

# --- Feature flags / logging ------------------------------------------------
# Enables mock fault controls, /admin/reset and the dashboard persona picker.
ENABLE_DEMO_FAULTS=true
ENABLE_DEMO_PERSONAS=true
LOG_LEVEL=info
